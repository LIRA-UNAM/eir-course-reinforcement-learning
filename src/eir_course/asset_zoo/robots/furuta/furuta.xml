<!--
  Furuta (rotary inverted) pendulum.

  The arm turns about the vertical axis and carries the pendulum on a hinge
  aligned with the arm. Pendulum angle 0 = upright, pi = hanging down.

  The arm actuator is not defined here: furuta_constants.py attaches the
  Booster K1 knee pitch motor (ACTUATOR_E6416), which also sets the arm's
  armature (reflected rotor inertia).
-->
<mujoco model="furuta">
  <compiler angle="radian" autolimits="true"/>

  <asset>
    <material name="base" rgba="0.3 0.3 0.35 1"/>
    <material name="arm" rgba="0.2 0.5 0.8 1"/>
    <material name="pendulum" rgba="0.9 0.5 0.1 1"/>
  </asset>

  <worldbody>
    <light name="light" pos="0 0 3" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>

    <!-- Pedestal holding the arm motor. -->
    <geom name="pedestal" type="cylinder" fromto="0 0 0 0 0 0.5" size="0.05" material="base"/>

    <body name="arm" pos="0 0 0.55">
      <joint name="arm" type="hinge" axis="0 0 1"/>
      <geom name="hub" type="cylinder" fromto="0 0 -0.05 0 0 0.02" size="0.04" material="base"/>
      <geom name="arm" type="capsule" fromto="0 0 0 0.3 0 0" size="0.015" material="arm"/>

      <body name="pendulum" pos="0.3 0 0">
        <!-- Hinge along the arm. qpos = 0 points the pendulum straight up. -->
        <joint name="pendulum" type="hinge" axis="1 0 0" damping="0.001"/>
        <geom name="pendulum" type="capsule" fromto="0.02 0 0 0.02 0 0.4" size="0.01" material="pendulum"/>
        <geom name="tip" type="sphere" pos="0.02 0 0.4" size="0.025" mass="0.05" material="pendulum"/>
      </body>
    </body>
  </worldbody>
</mujoco>
